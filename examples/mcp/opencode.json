{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "raspilot": {
      "type": "local",
      "command": [
        "/ABSOLUTE/PATH/.venv/bin/python",
        "/ABSOLUTE/PATH/mcp_server.py"
      ],
      "enabled": true,
      "environment": {
        "RASPILOT_DEVICE": "SERIAL_DO_APARELHO",
        "RASPILOT_STATE_DIR": "/ABSOLUTE/PATH/.raspilot/sessions"
      }
    }
  }
}
